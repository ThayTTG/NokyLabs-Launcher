<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NokyLabs.ViewModels"
             x:Class="NokyLabs.Views.LauncherUpdateBanner"
             x:DataType="vm:MainWindowViewModel">

  <!-- Aviso de nova versão do próprio launcher (aparece na Biblioteca e em Atualizações) -->
  <Border IsVisible="{Binding ShowLauncherBanner}"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
          CornerRadius="16" Padding="18,14">
    <Grid ColumnDefinitions="Auto,*,Auto">

      <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource BrandGradient}"
              VerticalAlignment="Center">
        <Viewbox Width="22" Height="22">
          <Path Classes="icon" Data="{DynamicResource IconSparkle}" Stroke="White" />
        </Viewbox>
      </Border>

      <StackPanel Grid.Column="1" Margin="16,0" Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="{Binding LauncherBannerTitle}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{Binding LauncherBannerText}" Classes="secondary" TextWrapping="Wrap" />
        <ProgressBar Classes="slim" Margin="0,6,0,0" Width="280" HorizontalAlignment="Left"
                     Minimum="0" Maximum="100" Value="{Binding LauncherProgress}"
                     IsIndeterminate="{Binding IsLauncherProgressIndeterminate}"
                     IsVisible="{Binding IsLauncherUpdating}" />
      </StackPanel>

      <Panel Grid.Column="2" VerticalAlignment="Center">
        <Button Classes="primary" MinWidth="150"
                Content="{Binding LauncherActionText}"
                Command="{Binding UpdateLauncherCommand}"
                IsVisible="{Binding ShowLauncherUpdateButton}" />
        <Button Classes="primary" MinWidth="150" Content="Reiniciar agora"
                Command="{Binding RestartLauncherCommand}"
                IsVisible="{Binding LauncherUpdateReady}" />
      </Panel>

    </Grid>
  </Border>
</UserControl>
