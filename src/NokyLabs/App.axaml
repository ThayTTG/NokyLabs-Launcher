<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NokyLabs.UI"
             x:Class="NokyLabs.App"
             RequestedThemeVariant="Dark">

  <!-- O tema (escuro, claro ou o do sistema) é aplicado no início pelo ThemeService,
       a partir da escolha salva em Configurações > Aparência. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Só o que é do launcher; as cores, ícones e raios vêm do Kit (NokyLabs.UI) -->
        <ResourceInclude Source="avares://NokyLabs/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Antes do Kit: valores-padrão que os estilos do Kit podem sobrescrever -->
    <StyleInclude Source="avares://NokyLabs/Styles/Base.axaml" />
    <!-- Kit NokyLabs com a cor do launcher: o roxo da marca -->
    <ui:NokyTheme Accent="#A068FF" />
    <!-- Depois do Kit: as peças que só o launcher tem (painel de detalhes, faixas, assistente…) -->
    <StyleInclude Source="avares://NokyLabs/Styles/Controls.axaml" />
  </Application.Styles>

</Application>
