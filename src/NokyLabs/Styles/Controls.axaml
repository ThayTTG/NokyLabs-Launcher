<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Estilos só do launcher. Texto, botões, cartões, selos, filtros, menu lateral, campos,
       barras e balões vêm do Kit NokyLabs (NokyLabs.UI), iguais aos dos outros apps. -->

  <!-- ===================== Banner da Biblioteca (o "hero" do Kit) ===================== -->
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource HeroBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HeroBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="28,24" />
  </Style>

  <!-- ===================== Selos de situação dos apps ===================== -->
  <!-- "No navegador" e "Acesso restrito" (o Kit já tem accent, success, warning e danger) -->
  <Style Selector="Border.badge.info"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" /></Style>
  <Style Selector="Border.badge.info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}" /></Style>

  <!-- ===================== Painel de detalhes ===================== -->
  <Style Selector="Panel.details-layer">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.details-layer.open">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Panel.details-layer Border.drawer">
    <Setter Property="RenderTransform" Value="translateX(48px)" />
    <Setter Property="Transitions">
      <Transitions>
        <!-- A mesma curva de saída suave do Kit -->
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="0.2,0.7,0.2,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.details-layer.open Border.drawer">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Border.platform-row">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.platform-row.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftHoverBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- ===================== Faixas da Biblioteca (rolam para a direita) ===================== -->
  <Style Selector="Button.shelf-prev:disabled, Button.shelf-next:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- ===================== Botão do app aberto ===================== -->
  <Style Selector="Button.running:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.running Ellipse.run-dot">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- Troca de rótulo no hover: só acontece em botões "running" ("Rodando" vira "Encerrar") -->
  <Style Selector="Button StackPanel.label-hover">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.running:pointerover StackPanel.label-hover">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.running:pointerover StackPanel.label-normal">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===================== Cartões de escolha (assistente e Aparência) ===================== -->
  <Style Selector="RadioButton.choice">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1.5" CornerRadius="16" Padding="18,16">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="RadioButton.choice:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="RadioButton.choice:checked">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Linha divisória (Configurações e assistente) -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Aviso destacado com contorno (simulação, instalação existente...) -->
  <Style Selector="Border.notice">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftHoverBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.notice.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <!-- ===================== Barra de rolagem mais discreta ===================== -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

</Styles>
