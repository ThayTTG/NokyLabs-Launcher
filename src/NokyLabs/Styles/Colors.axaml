<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Cores só do launcher ===================== -->
  <!-- As cores do Kit NokyLabs (fundo, superfícies, texto, Accent*, sucesso, aviso, erro)
       vêm da NokyLabs.UI. Aqui ficam só as que o launcher usa e o Kit não tem,
       sempre nas duas versões: escuro (o principal) e claro. -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <!-- "No navegador" e "Acesso restrito": azul-céu, para não se confundir com instalar/atualizar -->
      <SolidColorBrush x:Key="InfoBrush" Color="#7DD3FC" />
      <SolidColorBrush x:Key="InfoSoftBrush" Color="#7DD3FC" Opacity="0.16" />

      <!-- Banner da Biblioteca: o "hero" do Kit, com um brilho roxo no canto -->
      <RadialGradientBrush x:Key="HeroBrush" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="70%" RadiusY="150%">
        <GradientStop Offset="0" Color="#4D3A7A" />
        <GradientStop Offset="1" Color="#1C1729" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="HeroBorderBrush" Color="#4A3B6E" />

      <!-- Fundo escurecido atrás do painel de detalhes -->
      <SolidColorBrush x:Key="BackdropBrush" Color="#99060410" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="InfoBrush" Color="#0369A1" />
      <SolidColorBrush x:Key="InfoSoftBrush" Color="#0EA5E9" Opacity="0.14" />

      <RadialGradientBrush x:Key="HeroBrush" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="70%" RadiusY="150%">
        <GradientStop Offset="0" Color="#EBDDFF" />
        <GradientStop Offset="1" Color="#FFFFFF" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="HeroBorderBrush" Color="#D9C6F5" />

      <SolidColorBrush x:Key="BackdropBrush" Color="#66241B14" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
