<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ícones de traço, desenhados numa grade de 24x24.
       Use com: <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconX}" /></Viewbox> -->

  <!-- O "n" do NokyLabs (o mesmo desenho do ícone do app) -->
  <StreamGeometry x:Key="IconLogo">M7.5,7 V17 M7.5,11.5 A4.5,4.5 0 0 1 16.5,11.5 V17</StreamGeometry>

  <!-- Navegação -->
  <StreamGeometry x:Key="IconLibrary">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</StreamGeometry>
  <StreamGeometry x:Key="IconUpdates">M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M5,19.5 H19</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M4,7 H6.5 M11.5,7 H20 M4,17 H12.5 M17.5,17 H20 M6.5,7 A2.5,2.5 0 1 0 11.5,7 A2.5,2.5 0 1 0 6.5,7 Z M12.5,17 A2.5,2.5 0 1 0 17.5,17 A2.5,2.5 0 1 0 12.5,17 Z</StreamGeometry>

  <!-- Utilidades -->
  <StreamGeometry x:Key="IconSearch">M4,10.5 A6.5,6.5 0 1 0 17,10.5 A6.5,6.5 0 1 0 4,10.5 Z M15.5,15.5 L20,20</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3,6.5 A1.5,1.5 0 0 1 4.5,5 H9 L11,7 H19.5 A1.5,1.5 0 0 1 21,8.5 V17.5 A1.5,1.5 0 0 1 19.5,19 H4.5 A1.5,1.5 0 0 1 3,17.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M4,7 H20 M9,7 V4.5 H15 V7 M6.5,7 L7.5,20 H16.5 L17.5,7 M10,11 V16 M14,11 V16</StreamGeometry>
  <StreamGeometry x:Key="IconSparkle">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 Z</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7.5</StreamGeometry>
  <StreamGeometry x:Key="IconInstall">M12,3 V14 M7.5,9.5 L12,14 L16.5,9.5 M4,15 V19 A1,1 0 0 0 5,20 H19 A1,1 0 0 0 20,19 V15</StreamGeometry>
  <StreamGeometry x:Key="IconPortable">M7,3 H17 A2,2 0 0 1 19,5 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V5 A2,2 0 0 1 7,3 Z M9,7 H15 M9,17 H15</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M19.5,12 A7.5,7.5 0 1 1 16.8,6.2 M17,2.8 V6.5 H13.3</StreamGeometry>

</ResourceDictionary>
